# Copy to .env (git-ignored). Load with: set -a; source .env; set +a

# Eventstream > custom endpoint > Event Hub > SAS Key Authentication > Connection string-primary key
EVENTSTREAM_CONNECTION_STRING=

# Wikimedia asks every client to identify itself with contact info
WIKI_USER_AGENT="fabric-wiki-lakehouse/1.0 (your-email@example.com)"

# Optional: comma-separated wiki codes to keep (empty = all wikis)
WIKIS=enwiki,dewiki,trwiki
